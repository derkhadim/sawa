<div class="mb-6">
  <%= link_to @payment.apartment, class: "btn btn-ghost btn-sm mb-4" do %>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
    Retour
  <% end %>
</div>

<div class="max-w-2xl mx-auto">
  <!-- Entête -->
  <div class="text-center mb-6" style="background: var(--primary); color: white; border-radius: var(--radius) var(--radius) 0 0; padding: 2rem;">
    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin: 0 auto 0.5rem;">
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>
    </svg>
    <h1 style="font-size: 1.5rem; font-weight: 700; letter-spacing: 2px; margin-top: 0.5rem;">QUITTANCE DE LOYER</h1>
    <p style="color: rgba(255,255,255,0.7);"><%= t('date.month_names')[@payment.month] %> <%= @payment.year %></p>
  </div>

  <!-- Corps -->
  <div class="card" style="border-radius: 0 0 var(--radius) var(--radius);">
    <div class="card-content" style="padding: 2rem;">
      <table class="receipt-table">
        <tr>
          <td class="label">Référence</td>
          <td class="value"><code><%= @payment.reference %></code></td>
        </tr>
        <tr><td colspan="2"><hr></td></tr>
        <tr>
          <td class="label">Bailleur</td>
          <td class="value">Agence Sawa</td>
        </tr>
        <tr><td colspan="2"><hr></td></tr>
        <tr>
          <td class="label">Locataire</td>
          <td class="value"><%= link_to @payment.tenant.full_name, tenant_path(@payment.tenant), class: "text-link" %></td>
        </tr>
        <tr><td colspan="2"><hr></td></tr>
        <tr>
          <td class="label">Logement</td>
          <td class="value">
            <%= @payment.apartment.building.name %> — App. <%= @payment.apartment.number %>
            <%= "(Étage #{@payment.apartment.floor})" if @payment.apartment.floor.present? %>
            <br>
            <span class="text-muted" style="font-size: 0.875rem;"><%= @payment.apartment.building.address %></span>
          </td>
        </tr>
        <tr><td colspan="2"><hr></td></tr>
        <tr>
          <td class="label">Montant du loyer</td>
          <td class="value" style="font-weight: 700; font-size: 1.125rem;"><%= number_to_currency(@payment.amount, unit: "", precision: 0) %> FCFA</td>
        </tr>
        <tr><td colspan="2"><hr></td></tr>
        <% if @payment.status == 'paid' %>
          <tr>
            <td class="label">Date de paiement</td>
            <td class="value"><%= l(@payment.paid_at.to_date, format: :long) %></td>
          </tr>
          <tr><td colspan="2"><hr></td></tr>
          <tr>
            <td class="label">Statut</td>
            <td class="value">
              <span style="display: inline-flex; align-items: center; gap: 0.375rem; color: var(--success); font-weight: 600;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                Payé
              </span>
            </td>
          </tr>
        <% elsif @payment.status == 'submitted' %>
          <tr><td colspan="2"><hr></td></tr>
          <tr>
            <td class="label">Date de soumission</td>
            <td class="value"><%= l(@payment.created_at.to_date, format: :long) %></td>
          </tr>
          <tr><td colspan="2"><hr></td></tr>
          <tr>
            <td class="label">Statut</td>
            <td class="value">
              <span style="display: inline-flex; align-items: center; gap: 0.375rem; color: var(--warning); font-weight: 600;">
                Soumis — En attente de validation
              </span>
            </td>
          </tr>
        <% else %>
          <tr>
            <td class="label">Statut</td>
            <td class="value" style="color: var(--muted-foreground);"><%= @payment.status.capitalize %></td>
          </tr>
        <% end %>
      </table>

      <% if @payment.proof.present? %>
        <div style="margin-top: 1.5rem; text-align: center;">
          <p class="text-muted" style="font-size: 0.875rem; font-weight: 500; margin-bottom: 0.5rem;">Preuve de paiement</p>
          <a href="<%= @payment.proof %>" target="_blank">
            <img src="<%= @payment.proof %>" style="max-width: 100%; max-height: 250px; border-radius: 8px; border: 1px solid var(--border);">
          </a>
        </div>
      <% elsif @payment.payment_method == 'cash' %>
        <div style="margin-top: 1.5rem; text-align: center;">
          <p class="text-muted" style="font-size: 0.875rem; font-weight: 500; margin-bottom: 0.5rem;">Mode de paiement</p>
          <div style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: var(--radius);">
            <span style="font-size: 1.5rem;">💵</span>
            <span style="font-weight: 600; color: #166534;">Payé par cash</span>
          </div>
        </div>
      <% end %>

      <% if @payment.status == 'paid' %>
        <!-- Tampon -->
        <div style="text-align: center; margin-top: 2rem;">
          <div style="display: inline-block; border: 3px solid var(--success); border-radius: 4px; padding: 0.5rem 2rem; transform: rotate(-8deg);">
            <span style="color: var(--success); font-weight: 800; font-size: 1.25rem; letter-spacing: 4px;">PAYÉ</span>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <p class="text-muted" style="text-align: center; font-size: 0.8rem; margin-top: 1rem;">
    <% if @payment.status == 'paid' %>
      Cette quittance est générée automatiquement après validation du paiement.
    <% else %>
      Cette quittance sera disponible dès que l'agence aura validé votre paiement.
    <% end %>
  </p>

  <% if @payment.status == 'paid' %>
    <div style="text-align: center; margin-top: 1rem;">
      <button onclick="window.print()" class="btn btn-primary" style="gap: 0.5rem; display: inline-flex; align-items: center;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Télécharger la quittance (PDF)
      </button>
    </div>
  <% end %>
</div>

<style>
  .receipt-table { width: 100%; border-collapse: collapse; }
  .receipt-table td { padding: 0.5rem 0; vertical-align: top; }
  .receipt-table td.label { width: 160px; color: var(--muted-foreground); font-size: 0.875rem; font-weight: 500; }
  .receipt-table td.value { font-size: 1rem; }
  .receipt-table hr { border: none; border-top: 1px solid var(--border); margin: 0; }

  @media print {
    body { background: white !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .btn, .btn-ghost, .mb-6, .btn-primary { display: none !important; }
    .max-w-2xl { max-width: 100% !important; margin: 0 !important; }
    .card { box-shadow: none !important; border: 1px solid #ddd !important; }
    [style*="background: var(--primary)"] { background: #1a73e8 !important; }
  }
</style>
