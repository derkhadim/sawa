<div class="page-header" style="text-align: center;">
  <h1>Mon profil</h1>
</div>

<div class="card" style="max-width: 32rem; margin: 0 auto;">
  <div style="position: relative; width: 100%; height: 140px; border-radius: var(--radius) var(--radius) 0 0; overflow: hidden; background: #e5e7eb;">
    <img src="<%= @user.cover_photo.presence || '/cover-placeholder.png' %>" style="width: 100%; height: 100%; object-fit: cover;">
  </div>
  <div class="card-content" style="text-align: center; padding-top: 0;">
    <div style="display: flex; flex-direction: column; align-items: center; gap: 0.5rem; margin-top: 10px;">
      <div style="width: 80px; height: 80px; border-radius: 50%; overflow: hidden; border: 3px solid white; background: #e5e7eb;">
        <img src="<%= @user.profile_photo.presence || '/logo-circle.png' %>" style="width: 100%; height: 100%; object-fit: cover;">
      </div>
      <div>
        <div style="font-size: 1.25rem; font-weight: 700;">
          <%= @user.agence? ? @user.agency&.name.presence || @user.email : @user.full_name.strip.presence || @user.email %>
        </div>
        <span class="badge badge-secondary"><%= t("roles.#{@user.role}") %></span>
      </div>
    </div>

    <hr style="border: none; border-top: 1px solid var(--border); margin: 1.5rem 0;">

    <div style="max-width: 24rem; margin: 0 auto; text-align: left;">
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <% unless @user.agence? %>
          <div>
            <div style="font-size: 0.75rem; font-weight: 600; color: #6b7280; text-transform: uppercase; letter-spacing: 0.05em;">Prénom</div>
            <div style="font-size: 1rem;"><%= @user.first_name.presence || "—" %></div>
          </div>
          <div>
            <div style="font-size: 0.75rem; font-weight: 600; color: #6b7280; text-transform: uppercase; letter-spacing: 0.05em;">Nom</div>
            <div style="font-size: 1rem;"><%= @user.last_name.presence || "—" %></div>
          </div>
        <% end %>
        <div>
          <div style="font-size: 0.75rem; font-weight: 600; color: #6b7280; text-transform: uppercase; letter-spacing: 0.05em;">Email</div>
          <div style="font-size: 1rem;"><%= @user.email %></div>
        </div>
        <div>
          <div style="font-size: 0.75rem; font-weight: 600; color: #6b7280; text-transform: uppercase; letter-spacing: 0.05em;">Téléphone</div>
          <div style="font-size: 1rem;"><%= @user.phone.presence || "—" %></div>
        </div>
        <% if @user.agence? && @user.agency %>
          <div>
            <div style="font-size: 0.75rem; font-weight: 600; color: #6b7280; text-transform: uppercase; letter-spacing: 0.05em;">Agence</div>
            <div style="font-size: 1rem;"><%= @user.agency.name %></div>
          </div>
        <% end %>
      </div>
    </div>

    <hr style="border: none; border-top: 1px solid var(--border); margin: 1.5rem 0;">

    <%= link_to edit_profile_path, class: "btn btn-primary", style: "display: inline-flex; align-items: center; gap: 0.5rem; justify-content: center;" do %>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      Modifier le profil
    <% end %>
  </div>
</div>
