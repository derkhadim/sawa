<div class="page-header" style="text-align: center;">
  <h1>Mon profil</h1>
</div>

<div class="card" style="max-width: 32rem; margin: 0 auto;">
  <div class="card-content">
    <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.5rem;">
      <div style="position: relative; width: 100%; height: 120px; border-radius: var(--radius); overflow: hidden; background: #e5e7eb;">
        <img src="<%= @user.cover_photo.presence || '/cover-placeholder.png' %>" style="width: 100%; height: 100%; object-fit: cover;">
      </div>
      <div style="display: flex; flex-direction: column; align-items: center; gap: 0.5rem; margin-top: 18px;">
        <div style="width: 80px; height: 80px; border-radius: 50%; overflow: hidden; border: 3px solid white; background: #e5e7eb; flex-shrink: 0;">
          <img src="<%= @user.profile_photo.presence || '/logo-circle.png' %>" style="width: 100%; height: 100%; object-fit: cover;">
        </div>
        <div style="font-size: 1.125rem; font-weight: 600; text-align: center;">
          <%= @user.agence? ? @user.agency&.name.presence || @user.email : @user.full_name.strip.presence || @user.email %>
        </div>
      </div>
    </div>

    <%= form_for @user, url: profile_path, html: { class: "space-y-4", multipart: true, style: "max-width: 28rem; margin: 0 auto;" } do |f| %>
      <% unless @user.agence? %>
        <div class="space-y-2">
          <%= f.label :first_name, "Prénom", class: "form-label" %>
          <%= f.text_field :first_name, class: "form-input", required: true %>
        </div>

        <div class="space-y-2">
          <%= f.label :last_name, "Nom", class: "form-label" %>
          <%= f.text_field :last_name, class: "form-input", required: true %>
        </div>
      <% end %>

      <div class="space-y-2">
        <%= f.label :profile_photo, "Photo de profil", class: "form-label" %>
        <%= f.file_field :profile_photo, class: "form-input", accept: "image/*" %>
      </div>

      <div class="space-y-2">
        <%= f.label :cover_photo, "Photo de couverture", class: "form-label" %>
        <%= f.file_field :cover_photo, class: "form-input", accept: "image/*" %>
      </div>

      <div class="space-y-2">
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email, class: "form-input", required: true %>
      </div>

      <div class="space-y-2">
        <%= f.label :phone, "Téléphone", class: "form-label" %>
        <%= f.telephone_field :phone, class: "form-input", required: true %>
      </div>

      <hr style="border: none; border-top: 1px solid var(--border); margin: 1rem 0;">

      <p class="text-sm text-muted mb-2">Changer de mot de passe (laisser vide pour conserver l'actuel)</p>

      <div class="space-y-2">
        <%= f.label :password, "Nouveau mot de passe", class: "form-label" %>
        <%= f.password_field :password, class: "form-input" %>
      </div>

      <div class="space-y-2">
        <%= f.label :password_confirmation, "Confirmation", class: "form-label" %>
        <%= f.password_field :password_confirmation, class: "form-input" %>
      </div>

      <div class="form-actions">
        <%= f.submit "Enregistrer", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
