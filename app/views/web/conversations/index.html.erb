<div class="li-messaging">
  <div class="li-sidebar">
    <div class="li-sidebar-header">
      <h2>Messagerie</h2>
      <span class="li-msg-count"><%= @conversations.size %></span>
    </div>
    <div class="li-search-box">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="text" placeholder="Rechercher une conversation..." class="li-search-input" oninput="filterConversations(this.value)">
    </div>
    <div class="li-list">
      <% @conversations.each do |c| %>
        <% other = c.other_participant(current_user) %>
        <% next unless other %>
        <% unread = c.unread_count(current_user) %>
        <% last_msg = c.last_message %>
        <%= link_to conversations_path(selected_id: c.id), class: "li-item #{params[:selected_id] == c.id.to_s ? 'active' : ''}" do %>
          <div class="li-avatar">
            <%= other.full_name.first.upcase %>
          </div>
          <div class="li-body">
            <div class="li-top">
              <span class="li-name"><%= other.full_name %></span>
              <% if last_msg %>
                <span class="li-time"><%= time_ago_in_words(last_msg.created_at) %></span>
              <% end %>
            </div>
            <div class="li-bottom">
              <span class="li-preview <%= unread > 0 ? 'unread' : '' %>">
                <% if last_msg %>
                  <%= last_msg.sender_id == current_user.id ? 'Vous : ' : '' %><%= last_msg.body.truncate(50) %>
                <% else %>
                  <span class="text-muted">Nouvelle conversation</span>
                <% end %>
              </span>
              <% if unread > 0 %>
                <span class="li-badge"><%= unread %></span>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="li-main">
    <% if @selected && @other %>
      <div class="li-conv-header">
        <div class="li-conv-avatar"><%= @other.full_name.first.upcase %></div>
        <div class="li-conv-info">
          <div class="li-conv-name"><%= @other.full_name %></div>
          <div class="li-conv-role"><%= @other.agency&.name || @other.role&.capitalize %></div>
        </div>
      </div>

      <div class="li-thread" id="thread-scroll">
        <% if @messages.any? %>
          <% @messages.each do |m| %>
            <% is_self = m.sender_id == current_user.id %>
            <div class="li-row <%= is_self ? 'self' : 'other' %>">
              <div class="li-bubble <%= is_self ? 'self' : 'other' %>">
                <div class="li-bubble-text"><%= m.body %></div>
                <div class="li-bubble-meta">
                  <%= l(m.created_at, format: :short) %>
                  <% if m.read_at && is_self %>· Lu<% end %>
                </div>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="li-empty">
            <div class="li-empty-icon">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </div>
            <h3>Nouvelle conversation</h3>
            <p>Envoyez votre premier message</p>
          </div>
        <% end %>
      </div>

      <div class="li-input-bar">
        <%= form_with url: conversation_messages_path(@selected), method: :post, local: true, class: "li-form" do |f| %>
          <%= f.text_area :body, placeholder: "Écrivez un message...", class: "li-input", rows: 1, required: true %>
          <button type="submit" class="li-send">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          </button>
        <% end %>
      </div>
    <% else %>
      <div class="li-empty" style="flex: 1;">
        <div class="li-empty-icon">
          <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        </div>
        <h3>Vos messages</h3>
        <p class="text-muted">Sélectionnez une conversation dans la liste de gauche</p>
      </div>
    <% end %>
  </div>
</div>

<script>
function filterConversations(val) {
  document.querySelectorAll('.li-item').forEach(el => {
    const name = el.querySelector('.li-name')?.textContent?.toLowerCase() || '';
    const preview = el.querySelector('.li-preview')?.textContent?.toLowerCase() || '';
    el.style.display = name.includes(val.toLowerCase()) || preview.includes(val.toLowerCase()) ? '' : 'none';
  });
}
document.addEventListener('DOMContentLoaded', function() {
  var el = document.getElementById('thread-scroll');
  if (el) el.scrollTop = el.scrollHeight;
});
</script>
