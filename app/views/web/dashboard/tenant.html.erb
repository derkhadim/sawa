<div class="page-header" style="display: flex; align-items: center; justify-content: space-between;">
  <h1 style="margin: 0;">Mon espace</h1>
  <div style="display: flex; gap: 0.5rem;">
    <% if @apartments.any? %>
      <% first_building = @apartments.first.building %>
      <%= link_to "Signaler", tenant_new_incident_path, class: "btn btn-primary btn-sm" %>
      <%= link_to "Fil d'actu", building_publications_path(first_building), class: "btn btn-sm", style: "background: white; color: var(--primary); border-color: white;" %>
    <% end %>
  </div>
</div>

<% if @pending_contracts&.any? %>
  <div class="mb-6" style="width: 100%;">
    <% @pending_contracts.each do |contract| %>
      <div class="card" style="border-left: 4px solid var(--primary);">
        <div class="card-content" style="display: flex; justify-content: space-between; align-items: center;">
          <div>
            <p class="font-medium">Nouveau contrat à signer</p>
            <p class="text-sm text-muted">Contrat <%= contract.contract_number %> — <%= contract.apartment.building.name %></p>
          </div>
          <%= link_to "Voir et signer", contract_path(contract), class: "btn btn-primary btn-sm" %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<% if @apartments.any? %>
  <div class="grid grid-cols-2 gap-4 mb-6">
    <% @apartments.each do |apt| %>
      <% building = apt.building %>
      <div class="card">
        <div class="card-header">
          <span class="card-title">Appartement <%= apt.number %> — <%= building.name %></span>
          <span class="text-muted text-sm"><%= building.agency&.name %> · <%= building.address %></span>
        </div>
        <div class="card-content">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <p class="text-sm text-muted"><%= number_to_currency(apt.rent_amount, unit: "", precision: 0) %> FCFA/mois</p>
              <p class="text-muted text-sm mt-1">Étage <%= apt.floor || "—" %></p>
            </div>
            <div class="flex gap-2 items-end justify-end">
              <% current_month_paid = @payments.any? { |p| p.apartment_id == apt.id && p.month == Date.current.month && p.year == Date.current.year && %w[paid submitted].include?(p.status) } %>
              <% unless current_month_paid %>
                <%= link_to "Payer", new_apartment_payment_path(apt), class: "btn btn-primary btn-sm" %>
              <% end %>
            </div>
          </div>

        </div>
      </div>
    <% end %>
  </div>

  <div class="card">
    <div class="card-header">
      <span class="card-title">Tous les paiements</span>
      <%= link_to "Voir tout", payments_path, class: "btn btn-ghost btn-sm" %>
    </div>
    <div class="card-content p-0">
      <% if @payments.any? %>
        <div class="table-container">
          <table>
            <thead>
              <tr><th>Appartement</th><th>Immeuble</th><th>Période</th><th>Montant</th><th>Statut</th><th>Date</th></tr>
            </thead>
            <tbody>
              <% @payments.first(10).each do |p| %>
                <tr class="cursor-pointer hover:bg-muted/50" onclick="window.location='<%= payment_path(p) %>'">
                  <td class="text-muted text-sm">Appt <%= p.apartment.number %></td>
                  <td class="text-muted text-sm"><%= p.apartment.building.name %></td>
                  <td><%= t('date.month_names')[p.month] %> <%= p.year %></td>
                  <td><%= number_to_currency(p.amount, unit: "", precision: 0) %></td>
                  <td>
                    <span class="badge <%= p.status == 'paid' ? 'badge-success' : p.status == 'late' ? 'badge-destructive' : p.status == 'submitted' ? 'badge-info' : 'badge-warning' %>">
                      <%= p.status == 'paid' ? 'Payé' : p.status == 'late' ? 'Retard' : p.status == 'submitted' ? 'Soumis' : 'En attente' %>
                    </span>
                  </td>
                  <td class="text-muted text-sm"><%= (p.paid_at || p.created_at).strftime('%d/%m/%Y') rescue '-' %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="empty-state"><p class="text-muted">Aucun paiement</p></div>
      <% end %>
    </div>
  </div>

  <div class="card mt-4">
    <div class="card-header">
      <span class="card-title">Mes signalements</span>
      <%= link_to "Voir tout", tenant_incidents_path, class: "btn btn-ghost btn-sm" %>
    </div>
    <div class="card-content p-0">
      <% if @incidents.any? %>
        <div class="table-container">
          <table>
            <thead>
              <tr><th>Appartement</th><th>Titre</th><th>Statut</th><th>Date</th><th>Actions</th></tr>
            </thead>
            <tbody>
              <% @incidents.first(5).each do |i| %>
                <tr>
                  <td class="text-muted text-sm">Appt <%= i.apartment.number %></td>
                  <td class="font-medium"><%= i.title %></td>
                  <td>
                    <span class="badge <%= i.status == 'resolved' ? 'badge-success' : i.status == 'in_progress' ? 'badge-primary' : 'badge-warning' %>">
                      <%= i.status_label %>
                    </span>
                  </td>
                  <td class="text-muted text-sm"><%= l(i.created_at.to_date, format: :short) %></td>
                  <td><%= link_to "Voir détails", i, class: "btn btn-ghost btn-sm" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="empty-state"><p class="text-muted">Aucun signalement</p></div>
      <% end %>
    </div>
    <div class="card-footer">
      <%= link_to "Donner mon préavis de départ", new_move_out_notice_path, class: "btn btn-ghost btn-sm" %>
    </div>
  </div>
<% else %>
  <div class="card" style="max-width: 36rem; margin: 3rem auto;">
    <div class="card-content" style="text-align: center; padding: 3rem;">
      <div style="font-size: 3rem; margin-bottom: 1rem;">🏠</div>
      <h2 style="margin-bottom: 0.5rem;">Bienvenue sur Sawa !</h2>
      <p class="text-muted" style="margin-bottom: 1.5rem; font-size: 0.9375rem;">
        Votre compte a été créé avec succès. Vous serez notifié dès qu'un appartement vous sera attribué par votre agence.
      </p>
      <div style="background: var(--muted); border-radius: var(--radius); padding: 1rem; text-align: left; font-size: 0.875rem;">
        <p class="font-medium mb-2">Prochaines étapes :</p>
        <ol style="margin: 0; padding-left: 1.25rem; color: var(--muted-foreground); line-height: 2;">
          <li>Votre agence vous attribue un appartement</li>
          <li>Vous recevez un email de confirmation</li>
          <li>Vous pouvez payer votre loyer et faire vos signalements</li>
        </ol>
      </div>
    </div>
  </div>
<% end %>
