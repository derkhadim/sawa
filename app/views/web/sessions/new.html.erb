<div class="login-page">
  <div class="login-card">
    <div class="card p-8">
      <div class="login-header">
        <div class="login-icon">🏠</div>
        <h1>Sawa</h1>
        <p class="text-muted">Gestion Immobilière</p>
      </div>

      <%= form_tag login_path, class: "space-y-4" do %>
        <div class="space-y-2">
          <label class="form-label" for="email">Email</label>
          <%= email_field_tag :email, nil, class: "form-input", placeholder: "vous@exemple.com", required: true, autofocus: true %>
        </div>
        <div class="space-y-2">
          <label class="form-label" for="password">Mot de passe</label>
          <%= password_field_tag :password, nil, class: "form-input", placeholder: "••••••••", required: true %>
        </div>
        <div class="space-y-2">
          <label class="form-label">Type de compte</label>
          <div style="display: flex; gap: 0.75rem;">
            <label style="display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1rem; border: 1px solid var(--border); border-radius: var(--radius); cursor: pointer; flex: 1; justify-content: center;">
              <%= radio_button_tag :login_role, 'tenant', true %>
              Locataire
            </label>
            <label style="display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1rem; border: 1px solid var(--border); border-radius: var(--radius); cursor: pointer; flex: 1; justify-content: center;">
              <%= radio_button_tag :login_role, 'owner' %>
              Propriétaire
            </label>
          </div>
        </div>
        <%= submit_tag "Se connecter", class: "btn btn-primary w-full", style: "justify-content: center;" %>
      <% end %>

      <div class="login-link">
        Pas encore de compte ? <%= link_to "Créer un compte", register_path %>
      </div>
      <div class="login-link" style="margin-top: 0.25rem;">
        <%= link_to "Connexion professionnelle", pro_login_path %>
      </div>
    </div>
  </div>
</div>
