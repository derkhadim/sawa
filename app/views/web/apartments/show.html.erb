<div class="mb-6">
  <%= link_to @apartment.building, class: "btn btn-ghost btn-sm mb-4" do %>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
    Retour
  <% end %>
  <div class="flex items-center justify-between">
    <h1>Appartement <%= @apartment.number %></h1>
    <% if login_role == 'agence' %>
      <% owner_email = @apartment.building.owner&.email %>
      <% if owner_email && (owner_user = User.find_by(email: owner_email)) %>
        <%= button_to conversations_path, params: { user_id: owner_user.id }, method: :post, class: "btn btn-ghost btn-sm", form_class: "inline" do %>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          Contacter le propriétaire
        <% end %>
      <% end %>
      <%= link_to edit_apartment_path(@apartment), class: "btn btn-secondary btn-sm" do %>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        Modifier
      <% end %>
    <% end %>
  </div>
</div>

<div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.5rem; margin-bottom: 1.5rem;">
  <% @apartment.photo_list.each do |url| %>
    <div style="aspect-ratio: 4/3; border-radius: var(--radius); overflow: hidden; background: #f3f4f6;">
      <img src="<%= url %>" style="width: 100%; height: 100%; object-fit: cover;">
    </div>
  <% end %>
</div>

<div class="grid grid-cols-2 gap-4 mb-6">
  <div class="card">
    <div class="card-header"><span class="card-title">Informations</span></div>
    <div class="card-content space-y-2">
      <p><span class="text-muted text-sm">Immeuble:</span> <span class="font-medium"><%= @apartment.building.name %></span></p>
      <p><span class="text-muted text-sm">Étage:</span> <span class="font-medium"><%= @apartment.floor || "—" %></span></p>
      <p><span class="text-muted text-sm">Loyer:</span> <span class="font-bold text-primary text-lg"><%= number_to_currency(@apartment.rent_amount, unit: "", precision: 0) %> FCFA/mois</span></p>
      <p><span class="text-muted text-sm">Statut:</span> <span class="badge <%= @apartment.occupied? ? 'badge-success' : 'badge-warning' %>"><%= @apartment.occupied? ? 'Occupé' : 'Libre' %></span></p>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><span class="card-title">Locataire</span></div>
    <div class="card-content space-y-2">
      <% if @apartment.tenant %>
        <p><span class="font-medium"><%= link_to @apartment.tenant.full_name, tenant_path(@apartment.tenant), class: "text-link" %></span></p>
        <p class="text-muted text-sm"><%= @apartment.tenant.phone %></p>
        <p class="text-muted text-sm"><%= @apartment.tenant.email %></p>
        <% if login_role == 'agence' %>
          <div class="flex gap-2 mt-2">
            <%= button_to conversations_path, params: { user_id: @apartment.tenant.id }, method: :post, class: "btn btn-ghost btn-sm", form_class: "inline" do %>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              Contacter
            <% end %>
            <% if @apartment.contracts.signed.any? %>
              <%= link_to "Voir le contrat", contract_path(@apartment.contracts.signed.last), class: "btn btn-secondary btn-sm" %>
            <% end %>
            <%= button_to "Désassigner", unassign_tenant_apartment_path(@apartment), method: :post, class: "btn btn-destructive btn-sm", onclick: "return confirm('Retirer #{@apartment.tenant.full_name} de cet appartement ?')" %>
          </div>
        <% end %>
      <% else %>
        <p class="text-muted">Aucun locataire</p>
        <% if login_role == 'agence' %>
          <%= link_to "Créer un contrat", new_apartment_contract_path(@apartment), class: "btn btn-primary btn-sm mt-2" %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header">
    <span class="card-title">Paiements</span>
    <% if @apartment.occupied? && login_role == 'agence' %>
      <% current_month_paid = @payments.any? { |p| p.month == Date.current.month && p.year == Date.current.year && p.status == 'paid' } %>
      <% unless current_month_paid %>
        <%= button_to "💵 Paiement en espèces (#{number_to_currency(@apartment.rent_amount, unit: '', precision: 0)} F)", cash_payment_apartment_path(@apartment), method: :post, class: "btn btn-primary btn-sm", onclick: "return confirm('Enregistrer un paiement en espèces de #{number_to_currency(@apartment.rent_amount, unit: '', precision: 0)} FCFA pour #{@apartment.tenant&.full_name} ?')" %>
      <% end %>
    <% end %>
  </div>
  <div class="card-content p-0">
    <% if @payments.any? %>
      <div class="table-container">
        <table>
          <thead>
            <tr><th>Mois</th><th>Montant</th><th>Échéance</th><th>Payé le</th><th>Statut</th></tr>
          </thead>
          <tbody>
            <% @payments.each do |p| %>
              <tr class="cursor-pointer hover:bg-muted/50" onclick="window.location='<%= payment_path(p) %>'">
                <td><%= t('date.month_names')[p.month] %> <%= p.year %></td>
                <td><%= number_to_currency(p.amount, unit: "", precision: 0) %> F</td>
                <td class="text-muted"><%= l(p.due_date, format: :short) %></td>
                <td class="text-muted"><%= l(p.paid_at.to_date, format: :short) if p.paid_at %></td>
                <td><span class="badge <%= p.status == 'paid' ? 'badge-success' : p.status == 'late' ? 'badge-destructive' : 'badge-warning' %>"><%= p.status.capitalize %></span></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state"><p class="text-muted">Aucun paiement</p></div>
    <% end %>
  </div>
</div>

<% if @apartment.contracts.any? %>
  <div class="card mb-4">
    <div class="card-header">
      <span class="card-title">Contrats</span>
    </div>
    <div class="card-content p-0">
      <div class="table-container">
        <table>
          <thead>
            <tr><th>Numéro</th><th>Locataire</th><th>Statut</th><th>Date</th><th></th></tr>
          </thead>
          <tbody>
            <% @apartment.contracts.order(created_at: :desc).each do |c| %>
              <tr>
                <td class="font-medium"><%= c.contract_number %></td>
                <td class="text-muted text-sm"><%= c.tenant.full_name %></td>
                <td><span class="badge <%= c.signed? ? 'badge-success' : 'badge-warning' %>"><%= c.signed? ? 'Signé' : 'En attente' %></span></td>
                <td class="text-muted text-sm"><%= l(c.created_at.to_date, format: :short) %></td>
                <td><%= link_to "Voir", contract_path(c), class: "btn btn-ghost btn-sm" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% end %>

<div class="card">
  <div class="card-header"><span class="card-title">Signalements</span></div>
  <div class="card-content p-0">
    <% if @incidents.any? %>
      <div class="table-container">
        <table>
          <thead>
            <tr><th>Titre</th><th>Description</th><th>Statut</th><th>Date</th><th>Actions</th></tr>
          </thead>
          <tbody>
            <% @incidents.each do |i| %>
              <tr>
                <td class="font-medium"><%= i.title %></td>
                <td class="text-muted truncate" style="max-width: 200px;"><%= i.description %></td>
                <td><span class="badge <%= i.status == 'resolved' ? 'badge-success' : i.status == 'in_progress' ? 'badge-primary' : 'badge-warning' %>"><%= i.status_label %></span></td>
                <td class="text-muted"><%= l(i.created_at.to_date, format: :short) %></td>
                <td><%= link_to "Voir détails", i, class: "btn btn-ghost btn-sm" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state"><p class="text-muted">Aucun signalement</p></div>
    <% end %>
  </div>
</div>
