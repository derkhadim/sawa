<div class="page-header">
  <h1>Mes signalements</h1>
</div>

<div class="card">
  <div class="card-content p-0">
    <% if @incidents.any? %>
      <div class="table-container">
        <table>
          <thead>
            <tr><th>Appartement</th><th>Titre</th><th>Description</th><th>Statut</th><th>Date</th><th></th></tr>
          </thead>
          <tbody>
            <% @incidents.each do |i| %>
              <tr>
                <td class="text-muted text-sm">Appt <%= i.apartment.number %></td>
                <td class="font-medium"><%= i.title %></td>
                <td class="text-muted truncate" style="max-width: 200px;"><%= i.description %></td>
                <td>
                  <span class="badge <%= i.status == 'resolved' ? 'badge-success' : i.status == 'in_progress' ? 'badge-primary' : 'badge-warning' %>">
                    <%= i.status_label %>
                  </span>
                </td>
                <td class="text-muted"><%= l(i.created_at.to_date, format: :short) %></td>
                <td><%= link_to "Voir détails", i, class: "btn btn-ghost btn-sm" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state">
        <div class="empty-state-icon">✅</div>
        <h3>Aucun signalement</h3>
        <p>Tout est en ordre dans vos logements</p>
      </div>
    <% end %>
  </div>
</div>
