<div class="page-header">
  <h1>Signalements</h1>
  <%= link_to @apartment, class: "btn btn-ghost btn-sm" do %>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
    Retour
  <% end %>
</div>

<div class="card">
  <div class="card-content p-0">
    <% if @incidents.any? %>
      <div class="table-container">
        <table>
          <thead>
            <tr><th>Titre</th><th>Description</th><th>Statut</th><th>Date</th><th></th></tr>
          </thead>
          <tbody>
            <% @incidents.each do |i| %>
              <tr>
                <td class="font-medium"><%= i.title %></td>
                <td class="text-muted truncate" style="max-width: 280px;"><%= i.description %></td>
                <td>
                  <span class="badge <%= i.status == 'resolved' ? 'badge-success' : i.status == 'in_progress' ? 'badge-primary' : 'badge-warning' %>">
                    <%= i.status_label %>
                  </span>
                </td>
                <td class="text-muted"><%= l(i.created_at.to_date, format: :short) %></td>
                <td><%= link_to "Voir détails", i, class: "btn btn-ghost btn-sm" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state">
        <div class="empty-state-icon">✅</div>
        <h3>Aucun signalement</h3>
        <p>Tout est en ordre</p>
      </div>
    <% end %>
  </div>
</div>
