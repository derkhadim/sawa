<div class="mb-6">
  <%= link_to dashboard_tenant_path, class: "btn btn-ghost btn-sm mb-4" do %>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
    Retour
  <% end %>
  <h1>Signaler un problème</h1>
  <p class="text-muted text-sm mt-1">Appartement <%= @apartment.number %> — <%= @apartment.building.name %></p>
</div>

<div class="card max-w-lg mx-auto">
  <div class="card-content">
    <%= form_for [@apartment, @incident], html: { class: "space-y-4" } do |f| %>
      <div class="space-y-2">
        <%= f.label :title, "Titre", class: "form-label" %>
        <%= f.text_field :title, class: "form-input", placeholder: "Ex: Fuite d'eau", required: true %>
      </div>
      <div class="space-y-2">
        <%= f.label :description, "Description", class: "form-label" %>
        <%= f.text_area :description, class: "form-textarea", rows: 4, placeholder: "Décrivez le problème en détail...", required: true %>
      </div>
      <div class="form-actions">
        <%= f.submit "Envoyer", class: "btn btn-primary" %>
        <%= link_to "Annuler", dashboard_tenant_path, class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>
