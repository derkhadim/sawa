<div class="mb-6">
  <%= link_to owners_path, class: "btn btn-ghost btn-sm mb-4" do %>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
    Retour
  <% end %>
  <h1>Nouveau propriétaire</h1>
</div>

<div class="card max-w-lg mx-auto">
  <div class="card-content">
    <%= form_for @owner, html: { class: "space-y-4" } do |f| %>
      <div class="form-row">
        <div class="space-y-2">
          <%= f.label :first_name, "Prénom", class: "form-label" %>
          <%= f.text_field :first_name, class: "form-input", required: true %>
        </div>
        <div class="space-y-2">
          <%= f.label :last_name, "Nom", class: "form-label" %>
          <%= f.text_field :last_name, class: "form-input", required: true %>
        </div>
      </div>
      <div class="form-row">
        <div class="space-y-2">
          <%= f.label :phone, "Téléphone", class: "form-label" %>
          <%= f.telephone_field :phone, class: "form-input" %>
        </div>
        <div class="space-y-2">
          <%= f.label :email, class: "form-label" %>
          <%= f.email_field :email, class: "form-input" %>
        </div>
      </div>
      <div class="form-actions">
        <%= f.submit "Ajouter", class: "btn btn-primary" %>
        <%= link_to "Annuler", owners_path, class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>
