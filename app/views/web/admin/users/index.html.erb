<div class="page-header">
  <h1>Utilisateurs</h1>
  <span class="badge badge-secondary"><%= @users.size %> comptes</span>
</div>

<div class="card">
  <div class="card-content p-0">
    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th>Email</th>
            <th>Téléphone</th>
            <th>Rôle</th>
            <th>Agence</th>
            <th>Immeuble</th>
            <th>Inscrit le</th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td class="font-medium"><%= user.email %></td>
              <td class="text-muted"><%= user.phone %></td>
              <td><span class="badge <%= user.agence? ? 'badge-warning' : user.owner? ? 'badge-success' : 'badge-secondary' %>"><%= t("roles.#{user.role}") %></span></td>
              <td class="text-muted"><%= user.agency&.name || "—" %></td>
              <td class="text-muted"><%= user.building&.name || "—" %></td>
              <td class="text-muted"><%= l(user.created_at.to_date, format: :default) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
