<div class="page-header">
  <h1>Immeubles</h1>
  <% if login_role == 'agence' %>
    <%= link_to new_building_path, class: "btn btn-primary" do %>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Ajouter
    <% end %>
  <% end %>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
  <% @buildings.each do |b| %>
    <%= link_to b, class: "building-card no-underline text-inherit" do %>
      <div class="building-card-image building-card-image-square">
        <img src="<%= b.photo_url %>" alt="<%= b.name %>">
      </div>
      <div class="building-card-body">
        <div class="building-card-title"><%= b.name %></div>
        <div class="building-card-subtitle">
          <%= b.neighborhood.present? ? "#{b.neighborhood}" : b.address %>
          <%= "— #{b.commune}" if b.commune.present? %>
        </div>
        <div class="building-card-footer">
          <span class="building-card-price"><%= b.occupied_apartments %>/<%= b.apartments.size %> occupés</span>
          <span class="building-card-occupancy">
            <% pct = b.apartments.size > 0 ? (b.occupied_apartments.to_f / b.apartments.size * 100).round : 0 %>
            <%= pct %>%
          </span>
        </div>
      </div>
    <% end %>
  <% end %>

  <% if @buildings.empty? %>
    <div class="card col-span-full">
      <div class="empty-state">
        <div class="empty-state-icon">🏢</div>
        <h3>Aucun immeuble</h3>
        <p>Commencez par ajouter un immeuble</p>
        <% if login_role == 'agence' %>
          <%= link_to "Ajouter", new_building_path, class: "btn btn-primary mt-4" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
