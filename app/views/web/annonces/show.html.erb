<div class="mb-6">
  <%= link_to annonces_path, class: "btn btn-ghost btn-sm mb-4" do %>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
    Retour aux annonces
  <% end %>
</div>

<div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.5rem; margin-bottom: 2rem;">
  <% @apartment.photo_list.each_with_index do |url, i| %>
    <div style="aspect-ratio: 16/10; border-radius: var(--radius); overflow: hidden; background: #f3f4f6;">
      <img src="<%= url %>" style="width: 100%; height: 100%; object-fit: cover;">
    </div>
  <% end %>
</div>

<div class="grid grid-cols-3 gap-4 mb-6">
  <div class="card p-4" style="text-align: left;">
    <p class="text-xs text-muted mb-1">Immeuble</p>
    <p class="font-medium"><%= @apartment.building.name %></p>
    <p class="text-muted text-sm mt-1"><%= @apartment.building.address %></p>
  </div>
  <div class="card p-4" style="text-align: left;">
    <p class="text-xs text-muted mb-1">Détails</p>
    <p class="font-medium">Appartement <%= @apartment.number %></p>
    <p class="text-muted text-sm">Étage <%= @apartment.floor || "—" %></p>
  </div>
  <div class="card p-4" style="text-align: left;">
    <p class="text-xs text-muted mb-1">Loyer</p>
    <p class="text-xl font-bold text-primary"><%= number_to_currency(@apartment.rent_amount, unit: "", precision: 0) %> FCFA</p>
    <p class="text-xs text-muted">par mois</p>
  </div>
</div>

<div class="card p-4">
  <div class="flex gap-4">
    <div style="width: 60px; height: 60px; border-radius: 50%; overflow: hidden; background: #f3f4f6; flex-shrink: 0;">
      <img src="<%= @apartment.building.photo_url %>" style="width: 100%; height: 100%; object-fit: cover;">
    </div>
    <div>
      <p class="font-medium"><%= @apartment.building.name %></p>
      <p class="text-muted text-sm"><%= @apartment.building.neighborhood %><%= " — #{@apartment.building.commune}" if @apartment.building.commune.present? %></p>
      <p class="text-muted text-sm"><%= @apartment.building.apartments.size %> appartements</p>
    </div>
  </div>
</div>
