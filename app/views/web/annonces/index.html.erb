<div class="page-header">
  <h1>Nos annonces</h1>
  <span class="badge badge-secondary"><%= @apartments.size %> disponibles</span>
</div>

<% if @apartments.any? %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <% @apartments.each do |apt| %>
      <%= link_to annonce_path(apt), class: "building-card no-underline text-inherit" do %>
        <div class="building-card-image">
          <img src="<%= apt.photo_list.first %>" alt="Appartement <%= apt.number %>">
        </div>
        <div class="building-card-body">
          <div class="building-card-title">
            Appartement <%= apt.number %> — <%= apt.building.name %>
          </div>
          <div class="building-card-subtitle"><%= apt.building.address %></div>
          <div class="flex items-center gap-2 mb-2">
            <span class="badge badge-success">Libre</span>
            <span class="text-xs text-muted"><%= apt.building.neighborhood %></span>
            <span class="text-xs text-muted">· Étage <%= apt.floor %></span>
          </div>
          <div class="building-card-footer">
            <span class="building-card-price"><%= number_to_currency(apt.rent_amount, unit: "", precision: 0) %> FCFA</span>
            <span class="building-card-occupancy">par mois</span>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="card" style="max-width: 30rem; margin: 3rem auto;">
    <div class="card-content" style="text-align: center; padding: 3rem;">
      <div style="font-size: 3rem; margin-bottom: 1rem;">🏡</div>
      <h2 style="margin-bottom: 0.5rem;">Aucune annonce</h2>
      <p class="text-muted">Tous les appartements sont actuellement occupés.</p>
    </div>
  </div>
<% end %>
