<%= link_to :back, class: "btn btn-ghost btn-sm mb-4" do %>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
  Retour
<% end %>

<div class="card mb-6">
  <div class="card-content">
    <div class="flex gap-3 mb-3">
      <div class="pub-avatar"><%= @publication.tenant.first_name[0] %><%= @publication.tenant.last_name[0] %></div>
      <div>
        <div class="font-medium text-sm"><%= @publication.tenant.full_name %></div>
        <div class="text-xs text-muted"><%= @publication.building.name %></div>
        <div class="text-xs text-muted"><%= l(@publication.created_at, format: :long) %></div>
      </div>
    </div>
    <div style="font-size: 0.9375rem; line-height: 1.6;"><%= simple_format(@publication.content) %></div>
    <div class="flex items-center gap-3 mt-3 pt-3" style="border-top: 1px solid var(--border);">
      <%= button_to like_publication_path(@publication), method: :post, class: "btn btn-ghost btn-sm", style: "gap: 0.375rem;" do %>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="<%= @publication.liked_by?(current_user) ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-3.3H14zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"/></svg>
        <%= @publication.likes_count %>
      <% end %>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <span class="card-title">Commentaires (<%= @publication.comments_count %>)</span>
  </div>
  <div class="card-content p-0">
    <% if @comments.any? %>
      <% @comments.each do |c| %>
        <div class="<%= 'border-b' unless c == @comments.last %>" style="padding: 0.75rem 1.5rem;">
          <div class="flex gap-2">
            <div class="pub-avatar" style="width: 1.75rem; height: 1.75rem; font-size: 0.625rem;"><%= c.user.first_name[0] %><%= c.user.last_name[0] %></div>
            <div style="flex: 1;">
              <div>
                <span class="font-medium text-sm"><%= c.user.full_name %></span>
                <span class="text-xs text-muted ml-2"><%= l(c.created_at, format: :short) %></span>
              </div>
              <div style="font-size: 0.875rem; margin-top: 0.125rem;"><%= c.content %></div>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="empty-state" style="padding: 1.5rem;">
        <p class="text-muted">Aucun commentaire. Soyez le premier !</p>
      </div>
    <% end %>
  </div>
  <div class="card-footer">
    <%= form_for [@publication, @comment], html: { class: "flex gap-2 w-full" } do |f| %>
      <%= f.text_field :content, class: "form-input", placeholder: "Écrire un commentaire...", required: true, style: "flex: 1;" %>
      <%= f.submit "Envoyer", class: "btn btn-primary btn-sm" %>
    <% end %>
  </div>
</div>
