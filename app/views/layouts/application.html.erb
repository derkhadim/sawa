<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sawa — Gestion Immobilière</title>
  <link rel="preconnect" href="https://rsms.me/">
  <link rel="stylesheet" href="https://rsms.me/inter/inter.css">
  <%= stylesheet_link_tag "tailwind", "application" %>
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      document.querySelectorAll(".table-container table").forEach(function(table) {
        var headers = [];
        table.querySelectorAll("thead th").forEach(function(th) {
          headers.push(th.textContent.trim());
        });
        if (headers.length === 0) return;
        table.querySelectorAll("tbody tr").forEach(function(tr) {
          tr.querySelectorAll("td").forEach(function(td, i) {
            if (i < headers.length && !td.hasAttribute("data-label")) {
              td.setAttribute("data-label", headers[i]);
            }
          });
        });
      });
    });
  </script>
</head>
<body>
  <nav class="navbar">
    <div class="container">
      <div class="navbar-top">
        <div class="navbar-brand">
          <%= link_to (logged_in? ? (login_role == 'agence' ? dashboard_path : login_role == 'tenant' ? dashboard_tenant_path : login_role == 'owner' ? dashboard_owner_path : dashboard_admin_path) : root_path) do %>
            <span>Sawa</span>
          <% end %>
        </div>

        <div class="navbar-right">
          <% if logged_in? %>
            <div class="navbar-user">
              <div style="width: 32px; height: 32px; border-radius: 50%; overflow: hidden; background: #e5e7eb; flex-shrink: 0;">
                <img src="<%= current_user.profile_photo.presence || '/logo-circle.png' %>" style="width: 100%; height: 100%; object-fit: cover;">
              </div>
              <div>
                <span class="navbar-user-name"><%= login_role == 'agence' ? current_user.agency&.name.presence || current_user.email : current_user.full_name.strip.presence || current_user.email %></span>
                <span class="navbar-user-role"><%= t("roles.#{login_role}") %></span>
              </div>
            </div>
            <%= link_to profile_path, class: "btn btn-ghost btn-sm" do %>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
              Profil
            <% end %>
            <%= link_to logout_path, class: "btn btn-ghost btn-sm", data: { turbo_method: :get } do %>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
              Déconnexion
            <% end %>
          <% else %>
            <%= link_to "Se connecter", login_path, class: "btn btn-ghost btn-sm" %>
            <%= link_to "S'inscrire", register_path, class: "btn btn-primary btn-sm" %>
          <% end %>
        </div>
      </div>

      <div class="navbar-nav">
        <% if logged_in? %>
          <% if login_role == 'agence' %>
            <%= link_to dashboard_path, class: "nav-link #{current_page?(dashboard_path) ? 'active' : ''}" do %>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
              Dashboard
            <% end %>
            <%= link_to buildings_path, class: "nav-link #{controller_name == 'buildings' ? 'active' : ''}" do %>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M9 8h1"/><path d="M14 8h1"/><path d="M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16"/><path d="M9 21v-4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v4"/></svg>
              Immeubles
            <% end %>
            <%= link_to owners_path, class: "nav-link #{controller_name == 'owners' ? 'active' : ''}" do %>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              Propriétaires
            <% end %>
            <%= link_to agent_feed_path, class: "nav-link #{current_page?(agent_feed_path) ? 'active' : ''}" do %>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
              Fil d'actu
            <% end %>
            <%= link_to agent_incidents_path, class: "nav-link #{current_page?(agent_incidents_path) ? 'active' : ''}" do %>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              Signalements
            <% end %>
            <%= link_to agent_payments_path, class: "nav-link #{current_page?(agent_payments_path) ? 'active' : ''}" do %>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              Paiements
            <% end %>
            <%= link_to providers_path, class: "nav-link #{controller_name == 'providers' ? 'active' : ''}" do %>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              Prestataires
            <% end %>
            <%= link_to conversations_path, class: "nav-link #{controller_name == 'conversations' ? 'active' : ''}" do %>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              Messages
            <% end %>
          <% elsif login_role == 'tenant' %>
            <%= link_to dashboard_tenant_path, class: "nav-link #{current_page?(dashboard_tenant_path) ? 'active' : ''}" do %>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              Accueil
            <% end %>
            <% if current_user.has_apartment? %>
              <%= link_to building_publications_path(current_user.tenant_buildings.first), class: "nav-link" do %>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
                Fil d'actu
              <% end %>
              <%= link_to new_move_out_notice_path, class: "nav-link" do %>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                Départ
              <% end %>
              <%= link_to conversations_path, class: "nav-link #{controller_name == 'conversations' ? 'active' : ''}" do %>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                Messages
              <% end %>
            <% end %>
          <% elsif login_role == 'owner' %>
            <%= link_to dashboard_owner_path, class: "nav-link #{current_page?(dashboard_owner_path) ? 'active' : ''}" do %>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
              Dashboard
            <% end %>
            <%= link_to buildings_path, class: "nav-link #{controller_name == 'buildings' ? 'active' : ''}" do %>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M9 8h1"/><path d="M14 8h1"/><path d="M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16"/><path d="M9 21v-4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v4"/></svg>
              Immeubles
            <% end %>
            <%= link_to conversations_path, class: "nav-link #{controller_name == 'conversations' ? 'active' : ''}" do %>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              Messages
            <% end %>
          <% elsif login_role == 'super_admin' %>
            <%= link_to dashboard_admin_path, class: "nav-link #{current_page?(dashboard_admin_path) ? 'active' : ''}" do %>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
              KPIs
            <% end %>
            <%= link_to admin_agencies_path, class: "nav-link #{current_page?(admin_agencies_path) ? 'active' : ''}" do %>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M9 8h1"/><path d="M14 8h1"/><path d="M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16"/><path d="M9 21v-4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v4"/></svg>
              Agences
            <% end %>
            <%= link_to admin_users_path, class: "nav-link #{current_page?(admin_users_path) ? 'active' : ''}" do %>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              Utilisateurs
            <% end %>
            <%= link_to conversations_path, class: "nav-link #{controller_name == 'conversations' ? 'active' : ''}" do %>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              Messages
            <% end %>
          <% end %>
        <% end %>

        <%= link_to annonces_path, class: "nav-link #{current_page?(annonces_path) ? 'active' : ''}" do %>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M9 8h1"/><path d="M14 8h1"/><path d="M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16"/></svg>
          Annonces
        <% end %>
      </div>
    </div>
  </nav>

  <main class="container" style="padding-top: 1.5rem; padding-bottom: 3rem;">
    <% if flash[:notice] %>
      <div class="flash flash-notice"><%= flash[:notice] %></div>
    <% end %>
    <% if flash[:alert] %>
      <div class="flash flash-alert"><%= flash[:alert] %></div>
    <% end %>

    <%= yield %>
  </main>
</body>
</html>
